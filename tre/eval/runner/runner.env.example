# Cluster / site configuration of the E1 runner (tre/eval/runner). Copy to runner.env (same
# directory, or point RUNNER_ENV at it) and edit. Every line is VAR="${VAR:-default}", so a value
# exported by the caller always wins over this file. The scripts read runner.env when it
# exists, else this file (with a warning) - the defaults below are the values the 2026-10
# pilot ran with (two 4xA100 nodes, client on the control-plane node).
#
# Nothing site-specific (IPs, NodePorts, node names, NFS paths) is written in the scripts.

# ---- where results, the TRE checkout and the traces live
PILOT_ROOT="${PILOT_ROOT:-/data/nfs_shared_data/xxy/pilot-e1-20261005}"   # results: $PILOT_ROOT/<trace>[_s<seed>]/<arm>[-tag]
TRE_DIR="${TRE_DIR:-/data/nfs_shared_data/xxy/aibrix/tre}"                # deploy scripts, baselines arm tool
LOADGEN_TRE_DIR="${LOADGEN_TRE_DIR:-/data/nfs_shared_data/xxy/aibrix/tre}" # loadgen_v1 + replayer (client); sha recorded
ICSE="${ICSE:-/root/aibrix-main/CustomTraceGenerator/config/icse_final}"   # trace root: $ICSE/<trace>/<TRACE_FILE>
TRACE_FILE="${TRACE_FILE:-traces_tre.effective.json}"                      # same request plan for every arm
TRACE_SEGMENTS_FILE="${TRACE_SEGMENTS_FILE:-trace.json}"                   # phase table next to the trace (copied if present)
TRACE_SOURCE_MANIFEST="${TRACE_SOURCE_MANIFEST:-manifest.json}"            # v2 trace generator manifest (seed), copied if present
LOADGEN_CONFIG_ROOT="${LOADGEN_CONFIG_ROOT:-$LOADGEN_TRE_DIR/loadgen_v1/configs/traces_v14}"  # <root>/<trace>/config.yaml
MARKER="${MARKER:-/data/nfs_shared_data/xxy/TRE_EXCLUSIVE_WINDOW}"         # exclusive-window marker file

# ---- gateway entry the client sends to (Envoy NodePort of the TRE gateway)
GW="${GW:-http://192.168.223.76:31094}"

# ---- models and the per-arm start layout (binding ids <model>/<node>/<gpu[,gpu]>)
MODELS="${MODELS:-dsqwen-7b,dsllama-8b,dsqwen-14b}"
BASELINE="${BASELINE:-dsqwen-7b/nscc-ds-4a100-node9/0 dsllama-8b/nscc-ds-4a100-node9/1 dsqwen-14b/nscc-ds-4a100-node10/0,1}"

# ---- clock offsets: "<k8s node>=<ssh target>" pairs; "local" = this host (the reference clock)
CLOCK_NODES="${CLOCK_NODES:-nscc-ds-4a100-node9=root@192.168.223.75 nscc-ds-4a100-node10=local}"
CLOCK_SSH_OPTS="${CLOCK_SSH_OPTS:--o BatchMode=yes -o ConnectTimeout=5}"

# ---- namespaces and object names
TRE_NS="${TRE_NS:-tre-v2}"                         # controller, SM, Redis, gateway plugins, scaler
MODEL_NS="${MODEL_NS:-default}"                    # model Deployments / pods
APA_NS="${APA_NS:-default}"                        # APA PodAutoscaler CRs
AIBRIX_NS="${AIBRIX_NS:-aibrix-system}"            # aibrix-controller-manager (APA arm)
ENVOY_NS="${ENVOY_NS:-envoy-gateway-system}"       # Envoy of the TRE gateway
MODEL_SELECTOR="${MODEL_SELECTOR:-tre.aibrix.io/managed=true}"
CONTROLLER_DEPLOY="${CONTROLLER_DEPLOY:-tre-v2-controller}"
CONTROLLER_SELECTOR="${CONTROLLER_SELECTOR:-app.kubernetes.io/name=tre-v2-controller}"
SM_DEPLOY="${SM_DEPLOY:-tre-v2-service-manager}"
SM_SVC="${SM_SVC:-tre-v2-service-manager}"; SM_PORT="${SM_PORT:-8000}"
REDIS_SVC="${REDIS_SVC:-tre-v2-redis}"; REDIS_PORT="${REDIS_PORT:-6379}"
APA_CTRL_DEPLOY="${APA_CTRL_DEPLOY:-aibrix-controller-manager}"
GW_NS="${GW_NS:-tre-v2}"; GW_DEPLOY="${GW_DEPLOY:-tre-gateway-plugins}"; GW_SELECTOR="${GW_SELECTOR:-app=tre-gateway-plugins}"
BL_NS="${BL_NS:-tre-v2}"; BL_DEPLOY="${BL_DEPLOY:-tre-v2-baseline-scaler}"
SIDECAR_CONTAINER="${SIDECAR_CONTAINER:-tre-reissue-sidecar}"
ENGINE_PORT="${ENGINE_PORT:-8000}"                 # pod port serving /metrics (the reissue sidecar proxies vLLM)

# ---- sampler cadences (seconds)
SAMPLE_LAYOUT_S="${SAMPLE_LAYOUT_S:-1}"            # SM /v2/state -> layout.jsonl, gpu_map.jsonl
SAMPLE_PODS_S="${SAMPLE_PODS_S:-1}"                # every awake pod incl. hidden -> pod_metrics_1s.jsonl
SAMPLE_GAUGES_S="${SAMPLE_GAUGES_S:-5}"            # routable pods only -> pod_gauges.jsonl (as the pilot)
SAMPLE_APA_S="${SAMPLE_APA_S:-1}"                  # APA CR status -> apa_status.jsonl
SAMPLE_GPU_TRUTH_S="${SAMPLE_GPU_TRUTH_S:-1}"      # Redis tre:gpu_truth:* -> gpu_truth.jsonl
SAMPLE_RESOURCES_S="${SAMPLE_RESOURCES_S:-5}"      # kubelet /stats/summary -> resource_usage.jsonl
POD_LIST_REFRESH_S="${POD_LIST_REFRESH_S:-10}"

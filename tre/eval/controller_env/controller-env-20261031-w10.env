# Controller env of the campaigns of 2026-10-31 .. 2026-11-02 (campaign-icse-ktrace-20261031 while run_all3.sh had win10 applied, and
# campaign-icse-r3c-full-D / -r3c-full-F / -ktrace-full-F / -r3e-full-20261101): Deployment tre-v2-controller, container controller,
# as `kubectl set env --list` printed it.
# Source on the cluster: backups/release-20261101-receiverless/env-before.txt (2026-11-01 ~02:15); the same list is in
# backups/release-20261101-receiverless-waiver/env-after.txt (11-01 05:09) and backups/release-20261102-tpot/env-before.txt (11-02 03:09).
# backups/tss-win10-20261030/controller-env.before.txt (10-30) differs only in TRE_METRICS_WINDOW_MS (20000, before win10 was applied).
# The image tag is not part of the env: ktrace-20261031 ran on controller 20261029-d9fa1571, the 11-01 / 11-02 runs on 20261101-c8279678.
# TRE_METRICS_WINDOW_MS=10000 is the 10 s TSS window (live since the w10refit publication 2026-10-31 ~19:09; the ktrace batch had it from the
# win10 apply of run_all3.sh).
# TRE_ACTION_COOLDOWN is read by no controller image since 2026-10-29 (config.py REMOVED_TIMER_ENV: logged once, ignored).
SAFE_SCALE_E2E_MULTIPLIER=2
SAFE_SCALE_KV_CACHE_MAX=0.8
SAFE_SCALE_MIN_WINDOW_MS=60000
SAFE_SCALE_WINDOW_FLOOR_MS=20000
TRE_ABLATION_DISABLE_SAFESCALE=false
TRE_ABLATION_DISABLE_SLOW_LOOP=false
TRE_ACTION_COOLDOWN=1
TRE_DISABLE_ETA_GATE=false
TRE_EVIDENCE_PERIOD_MS=1000
TRE_FAIRNESS_INTERVAL_SECONDS=10
TRE_GATEWAY_ROUTE_NAMESPACE=tre-v2
TRE_GATEWAY_STATS_URL=http://tre-v2-envoy-stats.envoy-gateway-system.svc.cluster.local:19001/stats/prometheus
TRE_HIST_BASELINE_LOOKBACK_MS=90000
TRE_INCOMPLETE_POLICY=drop_model
TRE_INSTANT_SAMPLE_INTERVAL_MS=500
TRE_METRICS_PHASE_OFFSET_MS=500
TRE_METRICS_PHASE_RETRY_MS=250
TRE_METRICS_REDIS_URL=redis://tre-v2-redis:6379/0
TRE_METRICS_REFRESH_INTERVAL_SECONDS=5
TRE_METRICS_REFRESH_MODE=phase_aligned
TRE_METRICS_SCHEMA=v2
TRE_METRICS_WINDOW_MODE=sliding
TRE_METRICS_WINDOW_MS=10000
TRE_MIN_LATENCY_SAMPLES=10
TRE_MONITOR_INTERVAL_SECONDS=20
TRE_PAPER_STALE_MAX_MS=30000
TRE_PERCENTILE_MODE=bucket_upper
TRE_PROFILE=false
TRE_REDIS_URL=redis://tre-v2-redis:6379/0
TRE_REGISTRY_PATH=/etc/tre/registry.yaml
TRE_RESCUE_INTERVAL_SECONDS=5
TRE_SAFESCALE_DONOR_ERROR_RATE_MAX=0.01
TRE_SAFESCALE_DONOR_MIN_REQUESTS=20
TRE_SAFESCALE_SUPPRESS_HOT_PROACTIVE=0
TRE_SERVICE_MANAGER_URL=http://tre-v2-service-manager:8000

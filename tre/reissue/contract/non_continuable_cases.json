{
  "description": "Shared contract for whether a request can be resumed from its emitted tokens. Checked by the reissue sidecar (tre/reissue/tre_reissue/sidecar.py: non_continuable_reason) and the gateway plugin (pkg/plugins/gateway/tre_transparent_sleep.go: treNonContinuableReason). path is the raw request path (query included, as the gateway sees :path); body is the JSON request body, or body_raw its exact bytes when it is not a plain JSON value. want = non-continuable; reason = the reason string (null when continuable). Rules apply in order: endpoint, body, n, logprobs, echo, beam_search, tools, structured_output, prompt_form.",
  "cases": [
    {"name": "completions string prompt", "path": "/v1/completions", "body": {"prompt": "x"}, "want": false, "reason": null},
    {"name": "completions explicit defaults", "path": "/v1/completions", "body": {"prompt": "x", "n": 1, "best_of": 1, "logprobs": null, "echo": false, "use_beam_search": false}, "want": false, "reason": null},
    {"name": "completions empty string prompt", "path": "/v1/completions", "body": {"prompt": ""}, "want": false, "reason": null},
    {"name": "completions token ids", "path": "/v1/completions", "body": {"prompt": [1, 2, 3]}, "want": false, "reason": null},
    {"name": "completions token ids zero and negative", "path": "/v1/completions", "body": {"prompt": [0, -1, 7]}, "want": false, "reason": null},
    {"name": "completions one-element batch string", "path": "/v1/completions", "body": {"prompt": ["x"]}, "want": false, "reason": null},
    {"name": "completions one-element batch token ids", "path": "/v1/completions", "body": {"prompt": [[1, 2]]}, "want": false, "reason": null},
    {"name": "completions n float 1.0", "path": "/v1/completions", "body": {"prompt": "x", "n": 1.0}, "want": false, "reason": null},
    {"name": "completions documented drift (seed, penalties) is continuable", "path": "/v1/completions", "body": {"prompt": "x", "seed": 1, "presence_penalty": 0.5, "frequency_penalty": 0.5, "repetition_penalty": 1.1}, "want": false, "reason": null},
    {"name": "completions guided_json_object false and null guided field", "path": "/v1/completions", "body": {"prompt": "x", "guided_json_object": false, "guided_regex": null}, "want": false, "reason": null},
    {"name": "completions suffix and prompt_embeds null", "path": "/v1/completions", "body": {"prompt": "x", "suffix": null, "prompt_embeds": null}, "want": false, "reason": null},
    {"name": "field names are case-sensitive", "path": "/v1/completions", "body": {"prompt": "x", "N": 3, "Echo": true, "Logprobs": 1, "Suffix": "y"}, "want": false, "reason": null},
    {"name": "completions path with query string", "path": "/v1/completions?api-version=1&x=y", "body": {"prompt": "x"}, "want": false, "reason": null},
    {"name": "chat path with query string", "path": "/v1/chat/completions?stream=1", "body": {"messages": [{"role": "user", "content": "x"}]}, "want": false, "reason": null},
    {"name": "chat basic", "path": "/v1/chat/completions", "body": {"messages": [{"role": "user", "content": "x"}]}, "want": false, "reason": null},
    {"name": "chat logprobs false, top_logprobs 0", "path": "/v1/chat/completions", "body": {"messages": [{}], "logprobs": false, "top_logprobs": 0}, "want": false, "reason": null},
    {"name": "chat empty tools with auto", "path": "/v1/chat/completions", "body": {"messages": [{}], "tools": [], "tool_choice": "auto"}, "want": false, "reason": null},
    {"name": "chat tools switched off with none", "path": "/v1/chat/completions", "body": {"messages": [{}], "tools": [{"type": "function"}], "tool_choice": "none"}, "want": false, "reason": null},
    {"name": "chat tool_choice none written with a JSON escape", "path": "/v1/chat/completions", "body_raw": "{\"messages\":[{}],\"tools\":[{\"type\":\"function\"}],\"tool_choice\":\"\\u006eone\"}", "want": false, "reason": null},
    {"name": "chat functions switched off with function_call none", "path": "/v1/chat/completions", "body": {"messages": [{}], "functions": [{"name": "f"}], "function_call": "none"}, "want": false, "reason": null},
    {"name": "chat streaming empty tools", "path": "/v1/chat/completions", "body": {"messages": [{}], "stream": true, "tools": []}, "want": false, "reason": null},
    {"name": "chat response_format text", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": {"type": "text"}}, "want": false, "reason": null},
    {"name": "chat response_format without type", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": {}}, "want": false, "reason": null},
    {"name": "chat response_format key case-sensitive", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": {"Type": "json_object"}}, "want": false, "reason": null},
    {"name": "body with surrounding whitespace", "path": "/v1/completions", "body_raw": "  {\"prompt\":\"x\"}\n", "want": false, "reason": null},
    {"name": "duplicate key: last value wins", "path": "/v1/completions", "body_raw": "{\"prompt\":\"x\",\"n\":2,\"n\":1}", "want": false, "reason": null},

    {"name": "embeddings endpoint", "path": "/v1/embeddings", "body": {"input": "x"}, "want": true, "reason": "endpoint"},
    {"name": "responses endpoint", "path": "/v1/responses", "body": {"input": "x"}, "want": true, "reason": "endpoint"},
    {"name": "anthropic messages endpoint", "path": "/v1/messages", "body": {"messages": [{}]}, "want": true, "reason": "endpoint"},
    {"name": "trailing slash is another endpoint", "path": "/v1/completions/", "body": {"prompt": "x"}, "want": true, "reason": "endpoint"},
    {"name": "generation path only in the query", "path": "/v1/embeddings?next=/v1/completions", "body": {"prompt": "x"}, "want": true, "reason": "endpoint"},
    {"name": "endpoint checked before body", "path": "/v1/embeddings", "body_raw": "not json", "want": true, "reason": "endpoint"},

    {"name": "body not json", "path": "/v1/chat/completions", "body_raw": "not json", "want": true, "reason": "body"},
    {"name": "body empty", "path": "/v1/completions", "body_raw": "", "want": true, "reason": "body"},
    {"name": "body JSON null", "path": "/v1/completions", "body_raw": "null", "want": true, "reason": "body"},
    {"name": "body JSON array", "path": "/v1/completions", "body_raw": "[{\"prompt\":\"x\"}]", "want": true, "reason": "body"},
    {"name": "body JSON string", "path": "/v1/completions", "body_raw": "\"x\"", "want": true, "reason": "body"},
    {"name": "body with trailing garbage", "path": "/v1/completions", "body_raw": "{\"prompt\":\"x\"} x", "want": true, "reason": "body"},
    {"name": "body with non-standard NaN", "path": "/v1/completions", "body_raw": "{\"prompt\":\"x\",\"n\":NaN}", "want": true, "reason": "body"},

    {"name": "n 2", "path": "/v1/completions", "body": {"prompt": "x", "n": 2}, "want": true, "reason": "n"},
    {"name": "best_of 3", "path": "/v1/completions", "body": {"prompt": "x", "best_of": 3}, "want": true, "reason": "n"},
    {"name": "n not a number", "path": "/v1/completions", "body": {"prompt": "x", "n": "two"}, "want": true, "reason": "n"},
    {"name": "n numeric string", "path": "/v1/completions", "body": {"prompt": "x", "n": "1"}, "want": true, "reason": "n"},
    {"name": "n boolean", "path": "/v1/completions", "body": {"prompt": "x", "n": true}, "want": true, "reason": "n"},
    {"name": "n checked before prompt form", "path": "/v1/completions", "body": {"prompt": ["a", "b"], "n": 2, "suffix": "y"}, "want": true, "reason": "n"},

    {"name": "completions logprobs 0", "path": "/v1/completions", "body": {"prompt": "x", "logprobs": 0}, "want": true, "reason": "logprobs"},
    {"name": "completions logprobs 5", "path": "/v1/completions", "body": {"prompt": "x", "logprobs": 5}, "want": true, "reason": "logprobs"},
    {"name": "chat logprobs true", "path": "/v1/chat/completions", "body": {"messages": [{}], "logprobs": true}, "want": true, "reason": "logprobs"},
    {"name": "chat top_logprobs 2", "path": "/v1/chat/completions", "body": {"messages": [{}], "top_logprobs": 2}, "want": true, "reason": "logprobs"},
    {"name": "prompt_logprobs", "path": "/v1/completions", "body": {"prompt": "x", "prompt_logprobs": 1}, "want": true, "reason": "logprobs"},
    {"name": "logprobs checked before tools", "path": "/v1/chat/completions", "body": {"messages": [{}], "logprobs": true, "tools": [{"type": "function"}]}, "want": true, "reason": "logprobs"},

    {"name": "echo", "path": "/v1/completions", "body": {"prompt": "x", "echo": true}, "want": true, "reason": "echo"},
    {"name": "beam search", "path": "/v1/completions", "body": {"prompt": "x", "use_beam_search": true}, "want": true, "reason": "beam_search"},

    {"name": "tools offered (non-streaming)", "path": "/v1/chat/completions", "body": {"messages": [{}], "tools": [{"type": "function"}]}, "want": true, "reason": "tools"},
    {"name": "tools offered (streaming)", "path": "/v1/chat/completions", "body": {"messages": [{}], "stream": true, "tools": [{"type": "function"}]}, "want": true, "reason": "tools"},
    {"name": "tool_choice required", "path": "/v1/chat/completions", "body": {"messages": [{}], "stream": true, "tool_choice": "required"}, "want": true, "reason": "tools"},
    {"name": "tool_choice names a function", "path": "/v1/chat/completions", "body": {"messages": [{}], "tool_choice": {"type": "function", "function": {"name": "f"}}}, "want": true, "reason": "tools"},
    {"name": "functions offered", "path": "/v1/chat/completions", "body": {"messages": [{}], "stream": true, "functions": [{"name": "f"}]}, "want": true, "reason": "tools"},
    {"name": "tools not a list", "path": "/v1/chat/completions", "body": {"messages": [{}], "tools": "f"}, "want": true, "reason": "tools"},

    {"name": "response_format json_object", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": {"type": "json_object"}}, "want": true, "reason": "structured_output"},
    {"name": "response_format json_schema", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": {"type": "json_schema", "json_schema": {"name": "x", "schema": {}}}}, "want": true, "reason": "structured_output"},
    {"name": "response_format not an object", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": "weird"}, "want": true, "reason": "structured_output"},
    {"name": "response_format type not a string", "path": "/v1/chat/completions", "body": {"messages": [{}], "response_format": {"type": 5}}, "want": true, "reason": "structured_output"},
    {"name": "guided_json", "path": "/v1/completions", "body": {"prompt": "x", "guided_json": {"type": "object"}}, "want": true, "reason": "structured_output"},
    {"name": "guided_regex", "path": "/v1/completions", "body": {"prompt": "x", "guided_regex": "a+"}, "want": true, "reason": "structured_output"},
    {"name": "guided_choice", "path": "/v1/completions", "body": {"prompt": "x", "guided_choice": ["a", "b"]}, "want": true, "reason": "structured_output"},
    {"name": "guided_grammar", "path": "/v1/completions", "body": {"prompt": "x", "guided_grammar": "root ::= \"a\""}, "want": true, "reason": "structured_output"},
    {"name": "guided_json_object true", "path": "/v1/completions", "body": {"prompt": "x", "guided_json_object": true}, "want": true, "reason": "structured_output"},
    {"name": "structural_tag", "path": "/v1/chat/completions", "body": {"messages": [{}], "structural_tag": "{}"}, "want": true, "reason": "structured_output"},
    {"name": "structured_outputs", "path": "/v1/chat/completions", "body": {"messages": [{}], "structured_outputs": {"json": {"type": "object"}}}, "want": true, "reason": "structured_output"},
    {"name": "structured output checked before prompt form", "path": "/v1/completions", "body": {"prompt": ["a", "b"], "guided_regex": "a+"}, "want": true, "reason": "structured_output"},

    {"name": "completions suffix", "path": "/v1/completions", "body": {"prompt": "x", "suffix": "y"}, "want": true, "reason": "prompt_form"},
    {"name": "completions empty suffix still present", "path": "/v1/completions", "body": {"prompt": "x", "suffix": ""}, "want": true, "reason": "prompt_form"},
    {"name": "completions prompt_embeds", "path": "/v1/completions", "body": {"prompt": "x", "prompt_embeds": "AAAA"}, "want": true, "reason": "prompt_form"},
    {"name": "completions batch of strings", "path": "/v1/completions", "body": {"prompt": ["a", "b"]}, "want": true, "reason": "prompt_form"},
    {"name": "completions batch of token lists", "path": "/v1/completions", "body": {"prompt": [[1], [2]]}, "want": true, "reason": "prompt_form"},
    {"name": "completions empty list prompt", "path": "/v1/completions", "body": {"prompt": []}, "want": true, "reason": "prompt_form"},
    {"name": "completions prompt missing", "path": "/v1/completions", "body": {"max_tokens": 5}, "want": true, "reason": "prompt_form"},
    {"name": "completions prompt null", "path": "/v1/completions", "body": {"prompt": null}, "want": true, "reason": "prompt_form"},
    {"name": "completions prompt number", "path": "/v1/completions", "body": {"prompt": 5}, "want": true, "reason": "prompt_form"},

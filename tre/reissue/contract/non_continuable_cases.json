    {"name": "completions mixed token ids and string", "path": "/v1/completions", "body": {"prompt": [1, "a"]}, "want": true, "reason": "prompt_form"},
    {"name": "completions boolean token id", "path": "/v1/completions", "body": {"prompt": [true]}, "want": true, "reason": "prompt_form"},

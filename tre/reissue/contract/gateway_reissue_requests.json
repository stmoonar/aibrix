      "from": "sidecar_retry",
      "path": "/v1/completions",
      "headers": {"x-tre-bl-in-tokens": "5", "x-tre-reissue-depth": "1", "x-tre-exclude-pod": "pod-a"},
      "body": {"model": "m", "prompt": "one two three four", "max_tokens": 6, "temperature": 0, "stream": true, "stream_options": {"include_usage": true}},
      "reissue": "retried",
      "in_tokens": 5
    },
    {
      "name": "continue_completion_stream",
      "from": "sidecar_continue_completion",
      "path": "/v1/completions",
      "headers": {"x-tre-bl-in-tokens": "5", "x-tre-reissue-depth": "1", "x-tre-exclude-pod": "pod-a"},
